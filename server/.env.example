NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
FRONTEND_URL=http://127.0.0.1:5173
API_PUBLIC_URL=http://127.0.0.1:3000

# Local PostgreSQL. Replace the password and create this development database before migrating.
DATABASE_URL=postgresql://stayflow_user:replace_me@127.0.0.1:5432/stayflow?schema=public
SESSION_TTL_DAYS=14

# Optional Google Calendar OAuth. Set all four values together.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/integrations/google-calendar/callback
# INTEGRATION_ENCRYPTION_KEY=64_hex_characters_from_openssl_rand_hex_32

# Optional outbound email. Set all five values together.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=stayflow@example.com

# Optional inbound email provider webhook. Set both values together and route a catch-all address.
# INBOUND_EMAIL_DOMAIN=mail.example.com
# INBOUND_EMAIL_WEBHOOK_SECRET=replace_with_at_least_32_random_characters

# Optional AI assistant. Without a key, the assistant uses local read-only answers.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
